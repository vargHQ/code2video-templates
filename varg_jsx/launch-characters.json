    "card_model": "nano_banana_2 (google route), 1364×768, aspect 16:9",
    "moderation": "video_safe=false → PiAPI rejects any Seedance request containing this reference.",
    "board": "vargHQ/rnd/footer-loop-board.html",
    "templates": [
      "vargHQ/templates/footer-loop-hypercars.tsx",
      "vargHQ/templates/footer-photoshoot-series.tsx"
    ]
